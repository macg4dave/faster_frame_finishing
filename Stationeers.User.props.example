<Project>
  <!--
    Copy this file to Stationeers.User.props (git-ignored) and set the path to your
    Stationeers installation, i.e. the folder that contains rocketstation.exe.
  -->
  <PropertyGroup>
    <StationeersDirectory>F:\SteamLibrary\steamapps\common\Stationeers</StationeersDirectory>

    <!-- Optional: copy the built mod into your local LaunchPad mods folder after each build. -->
    <!-- <DeployToGame>true</DeployToGame> -->

    <!-- Optional: where DeployToGame copies the mod. By default it is read from <SavePath> in
         Documents\My Games\Stationeers\setting.xml (+ \mods), the same folder the game reads. -->
    <!-- <StationeersModsDirectory>D:\Stationeers\mods</StationeersModsDirectory> -->
  </PropertyGroup>
</Project>
